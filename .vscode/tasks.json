{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run PaletteLab",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev",
                "--",
                "--host",
                "127.0.0.1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "http://127\\.0\\.0\\.1:5173"
                }
            }
        }
    ]
}
